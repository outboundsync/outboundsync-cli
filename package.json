{
  "name": "outboundsync",
  "version": "0.0.0-dev",
  "description": "OutboundSync CLI — call the OutboundSync API from your terminal",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/outboundsync/outboundsync-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outboundsync/outboundsync-cli.git"
  },
  "bugs": {
    "url": "https://github.com/outboundsync/outboundsync-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "outboundsync": "dist/outboundsync.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts && node --test test/*.test.mjs",
    "check:api-coverage": "node scripts/check-api-coverage.mjs",
    "ci": "npm run typecheck && npm run test",
    "release:preview": "node scripts/release-calver.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "yaml": "^2.8.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
